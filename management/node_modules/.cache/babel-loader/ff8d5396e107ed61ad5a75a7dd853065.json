er}]\n        this.win = Math.round(this.bet.win*100)/100\n        this.visible = true\n      },\n      onReset(evt) {\n        evt.preventDefault()\n        \n        this.amount = ''\n        \n        this.show = false\n        this.$nextTick(() => {\n          this.show = true\n        })\n      }\n    }\n  }\n</script>\n\n<style>\n  #input-group-2 {\n    max-width: 300px;\n    margin-left: 41%;\n  }\n</style>"],"sourceRoot":"src/components/tabs"}]}