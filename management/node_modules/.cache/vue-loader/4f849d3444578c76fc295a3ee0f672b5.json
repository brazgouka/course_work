mplate>\n        </b-table>\n        <b-pagination\n            v-model=\"currentPage\"\n            :total-rows=\"rows\"\n            :per-page=\"perPage\"\n            align=\"center\"\n            aria-controls=\"arbitrages-table\">\n        </b-pagination>\n    </div>\n</template>\n\n<script>\n    import CalculateBet from './CalculateBet.vue'\n    \n    export default {\n\n        methods: {\n            onRowSelected(items) {\n                this.selected = items\n            },\n            sync() {\n                fetch('http://localhost:8081/', {\n                    method: 'get'\n                })\n            },\n            reloadArbitages() {\n                fetch('http://localhost:8081/arbitrages', {\n                    method: 'get'\n                }).then(response => {\n                    return response.json()\n                }).then(jsonData => {\n                    this.arbitrages = jsonData\n                })\n            }\n        },\n        components: {\n            CalculateBet\n        },\n\n        data() {\n            return {\n                sortBy: 'firstTeam',\n                sortDesc: true,\n                fields: [\n                    { key: 'firstTeam' },\n                    { key: 'secondTeam' },\n                    { key: 'firstTeamCoefficient' },\n                    { key: 'secondTeamCoefficient' },\n                    { key: 'firstTeamBookmaker' },\n                    { key: 'secondTeamBookmaker' },\n                    { key: 'arbitrage'}\n                ],\n                arbitrages: [],\n                currentPage: 1,\n                perPage: 5,\n                selectMode: 'single',\n                modalShow: false,\n                selected: []\n            }\n        },\n\n        computed: {\n            rows() {\n                return this.arbitrages.length\n            }\n        },\n\n        mounted: function() {\n            this.reloadArbitages();\n        }\n    }\n</script>"]}]}