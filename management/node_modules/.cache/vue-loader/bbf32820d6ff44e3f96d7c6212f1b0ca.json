ss-bar :value=\"Math.ceil(arbitrages.length*10/games.length)\" variant=\"success\"></b-progress-bar>\n        </b-progress>\n        <br/><br/>\n        <b-table id=\"games-table\" striped hover @row-selected=\"onRowSelected\" :select-mode=\"selectMode\" :sort-desc.sync=\"sortDesc\" :sort-by.sync=\"sortBy\" :current-page=\"currentPage\" :per-page=\"perPage\" :items=\"games\" :fields=\"fields\"></b-table>\n        <b-pagination\n            v-model=\"currentPage\"\n            :total-rows=\"rows\"\n            :per-page=\"perPage\"\n            align=\"center\"\n            aria-controls=\"games-table\">\n        </b-pagination>\n    </div>\n</template>\n\n<script>\n\n    export default {\n\n        methods: {\n            onRowSelected(items) {\n                this.selected = items\n            },\n            sync() {\n                fetch('http://localhost:8081/', {\n                    method: 'get'\n                })\n            },\n            reloadGames() {\n                fetch('http://localhost:8081/games', {\n                    method: 'get'\n                }).then(response => {\n                    return response.json()\n                }).then(jsonData => {\n                    this.games = jsonData\n                })\n                fetch('http://localhost:8081/arbitrages', {\n                    method: 'get'\n                }).then(response => {\n                    return response.json()\n                }).then(jsonData => {\n                    this.arbitrages = jsonData\n                })\n            }\n        },\n\n        data() {\n            return {\n                sortBy: 'bookmaker',\n                sortDesc: true,\n                selectMode: 'single',\n                fields: [\n                    { key: 'firstTeam' },\n                    { key: 'secondTeam' },\n                    { key: 'firstTeamCoefficient' },\n                    { key: 'secondTeamCoefficient' },\n                    { key: 'bookmaker' }\n                ],\n                games: [],\n                currentPage: 1,\n                perPage: 10,\n                modalShow: false,\n                selected: [],\n                arbitrages: []\n            }\n        },\n\n        computed: {\n            rows() {\n                return this.games.length\n            }\n        },\n\n        mounted: function() {\n            this.reloadGames();\n        }\n    }\n</script>\n\n<style>\n  #progress {\n    max-width: 1400px;\n    margin-left: 8%;\n  }\n</style>"]}]}